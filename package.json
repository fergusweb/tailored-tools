{
  "name": "tailored-tools",
  "version": "3.0.4",
  "repository": "https://github.com/fergusweb/tailored-tools",
  "license": "GPL-3.0",
  "main": "build/index.js",
  "packageManager": "pnpm@12.11.2",
  "files": [
    "tools.php",
    "readme.txt",
    "includes",
    "tools",
    "js",
    "resource",
    "assets/*.png"
  ],
  "scripts": {
    "start": "wp-env start",
    "debug": "wp-env start --xdebug",
    "stop": "wp-env stop",
    "build": "wp-scripts build --webpack-copy-php",
    "format": "wp-scripts format",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "packages-update": "wp-scripts packages-update",
    "plugin-zip": "wp-scripts plugin-zip && zip -d tailored-tools.zip package.json README.md",
    "watch": "wp-scripts start --webpack-copy-php"
  },
  "devDependencies": {
    "@wordpress/env": "^10.3",
    "@wordpress/scripts": "^27.9.0"
  },
  "overrides": {
    "rimraf": {
      "glob": "^9"
    }
  }
}